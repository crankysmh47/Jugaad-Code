{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR//\\\\//}/.claude/hooks/pre_tool_call.sh\"",
            "timeout": 15,
            "statusMessage": "jugaadi soch raha hai..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR//\\\\//}/.claude/hooks/post_tool_call.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"${JUGAADI_CLAUDE_SCRIPTS:-${CLAUDE_PROJECT_DIR//\\\\//}/scripts}/statusline.py\"",
    "padding": 1,
    "refreshInterval": 30
  }
}
